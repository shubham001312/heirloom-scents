[TEMPLATE]
# ==========================================================================
# Heirloom Scents — Environment Variables
# ==========================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real secrets.

# --------------------------------------------------------------------------
# Inquiry Submission (Web3Forms — free tier)
# --------------------------------------------------------------------------
# Get your access key at https://web3forms.com (enter your email, no card).
#
# NOTE: Web3Forms' free plan only accepts CLIENT-SIDE submissions — server-side
# calls return 403 ("Pro plan required"). The form posts directly from the
# browser, and Web3Forms explicitly states the access key is safe to make
# public. That is why this variable is prefixed NEXT_PUBLIC_ (Next.js inlines
# it into the client bundle).
#
# You can still deploy and run the site WITHOUT this variable — the form will
# simply show a friendly "email us directly" message until it is set.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --------------------------------------------------------------------------
# Deployment
# --------------------------------------------------------------------------
# Base URL for the site (used for OG tags, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://heirloomscents.com

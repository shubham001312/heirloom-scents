# ==========================================================================
# Heirloom Scents — Environment Variables
# ==========================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real secrets.

# --------------------------------------------------------------------------
# Inquiry Submission (Web3Forms)
# --------------------------------------------------------------------------
# Get your access key at https://web3forms.com
# Enter your email to receive a free access key
WEB3FORMS_ACCESS_KEY=

# Email address where inquiry notifications are sent
INQUIRY_EMAIL=hello@heirloomscents.com

# --------------------------------------------------------------------------
# Rate Limiting
# --------------------------------------------------------------------------
# Maximum inquiry submissions per IP per window (default: 5)
RATE_LIMIT_MAX=5
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# --------------------------------------------------------------------------
# Security
# --------------------------------------------------------------------------
# Random string for CSRF protection (generate with: openssl rand -hex 32)
CSRF_SECRET=

# --------------------------------------------------------------------------
# Deployment
# --------------------------------------------------------------------------
# Base URL for the site (used for OG tags, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://heirloomscents.com
